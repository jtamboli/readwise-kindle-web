# Readwise API Token (required)
# Get your token from: https://readwise.io/access_token
READWISE_API_TOKEN=your_token_here

# Pagination settings
# Character budget per page (tune based on your Kindle screen)
KINDLE_PAGE_CHAR_BUDGET=1800

# Put images on separate pages (true/false)
IMAGE_SEPARATE_PAGE=true

# Cache settings
# List cache TTL in seconds (default: 300 = 5 minutes)
CACHE_LIST_TTL=300
