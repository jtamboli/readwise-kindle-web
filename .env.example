# Readwise API Token (required)
# Get your token from: https://readwise.io/access_token
KINDLE_READWISE_API_TOKEN=your_token_here

# Reader app session (optional) - enables syncing reading position back to
# Readwise. The public API can't write position, so this uses the private
# state-sync API with a session captured from the official iOS app: record
# its traffic (e.g. a HAR from a proxy) and copy the `mobilesession` request
# header sent to readwise.io/reader/api/state. Leave unset to keep position
# on the device only. See docs/readwise-private-state-api.md.
KINDLE_READWISE_MOBILE_SESSION=

# Cache settings
# List cache TTL in seconds (default: 300 = 5 minutes)
KINDLE_CACHE_LIST_TTL=300

# HTTP Basic Auth (optional)
# Set BOTH to require a username/password for every request. Leave unset to
# disable auth (e.g. trusted local network). Recommended for public deploys.
BASIC_AUTH_USERNAME=kindle
BASIC_AUTH_PASSWORD=your_password_here
