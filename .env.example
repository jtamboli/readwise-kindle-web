# Readwise API Token (required)
# Get your token from: https://readwise.io/access_token
READWISE_API_TOKEN=your_token_here

# Cache settings
# List cache TTL in seconds (default: 300 = 5 minutes)
CACHE_LIST_TTL=300

# HTTP Basic Auth (optional)
# Set BOTH to require a username/password for every request. Leave unset to
# disable auth (e.g. trusted local network). Recommended for public deploys.
BASIC_AUTH_USERNAME=kindle
BASIC_AUTH_PASSWORD=your_password_here
